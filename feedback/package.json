{
  "name": "feedback",
  "version": "0.1.0",
  "description": "",
  "type": "module",
  "private": true,
  "scripts": {
    "build:dev": "meocord build --dev",
    "build:prod": "meocord build --prod",
    "start": "meocord start --prod",
    "start:dev": "meocord start --dev",
    "start:prod": "meocord start --prod",
    "register": "meocord register --build",
    "lint": "eslint --fix && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "meocord": "^4.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-istanbul": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "reflect-metadata": "^0.2.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "@swc/core": false,
    "fsevents": false,
    "unrs-resolver": false
  }
}
